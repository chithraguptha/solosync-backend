PORT=4000
MONGODB_URI=mongodb://localhost:27017/solosync
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# WAHA
WAHA_URL=http://localhost:3000
WAHA_API_KEY=replace-with-waha-api-key
WAHA_WEBHOOK_URL=http://localhost:4000/webhooks/waha
WAHA_WEBHOOK_HMAC_KEY=replace-with-webhook-hmac-key

# Test mode: keep false until a payment provider is integrated.
BILLING_ENABLED=false
ACTIVATION_FEE_PAISE=39900
MESSAGE_FEE_PAISE=10

# Razorpay (leave BILLING_ENABLED=false for local testing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# Internal operations dashboard
ADMIN_EMAIL=admin@solosync.local
ADMIN_PASSWORD=change-this-local-password
